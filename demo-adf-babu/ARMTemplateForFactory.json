{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-babu"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_DS_destination_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DS_destination'"
		},
		"LS_destination_02_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_destination_02'"
		},
		"LS_destination_file_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_destination_file'"
		},
		"LS_sourceserver_02_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_sourceserver_02'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://destinationstoragenname.dfs.core.windows.net/"
		},
		"AzureSqlDatabase2_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sourceserverserver.database.windows.net"
		},
		"AzureSqlDatabase2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sourcedatabase"
		},
		"LS_DS_destination_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://destinationstoragenname.dfs.core.windows.net/"
		},
		"LS_destination_02_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://destinationstoragenname.dfs.core.windows.net/"
		},
		"LS_destination_file_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://destinationstoragenname.dfs.core.windows.net/"
		},
		"LS_sourceserver_02_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sourceserverserver.database.windows.net"
		},
		"LS_sourceserver_02_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sourcedatabase"
		},
		"LS_sourceserver_02_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "babu"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/data injection pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "send_injection_pipiline_for_failure",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "count check",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "email pipeline",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Table_name": {
									"value": "@pipeline().parameters.Table_name",
									"type": "Expression"
								},
								"emailrecepient": {
									"value": "@pipeline().globalParameters.emailglobalparameter",
									"type": "Expression"
								},
								"status": "failure"
							}
						}
					},
					{
						"name": "to get metedata_date",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select watermark_value from metadata.table_watermarks where table_name='@{toLower(pipeline().parameters.Table_name)}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_sourceserver_02",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"Table_name": "employee"
								}
							}
						}
					},
					{
						"name": "fetch new rows from table",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "to get metedata_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n'SELECT COUNT(*) AS count FROM dbo.',\npipeline().parameters.Table_name,\n' WHERE datemodified > CAST(''',\nactivity('to get metedata_date').output.firstRow.watermark_value,\n''' AS datetime2)'\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_sourceserver_02",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"Table_name": "employee"
								}
							}
						}
					},
					{
						"name": "count check",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "fetch new rows from table",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "to get metedata_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('fetch new rows from table').output.firstRow.count,0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "data injection",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT *\nFROM dbo.Employee\nWHERE DateModified > CAST('@{activity('to get metedata_date').output.firstRow.watermark_value}' AS datetime2)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_sourceserver_02",
											"type": "DatasetReference",
											"parameters": {
												"schema": "dbo",
												"Table_name": {
													"value": "@pipeline().parameters.Table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_target_02",
											"type": "DatasetReference",
											"parameters": {
												"Table_name": {
													"value": "@pipeline().parameters.Table_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "updating watermark value",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "data injection",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_sourceserver_02",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update metadata.table_watermarks\nset watermark_value=GETUTCDATE()\nwhere table_name='@{toLower(pipeline().parameters.Table_name)}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "send_injection_pipiline",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "count check",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "email pipeline",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Table_name": {
									"value": "@pipeline().parameters.Table_name",
									"type": "Expression"
								},
								"emailrecepient": {
									"value": "@pipeline().globalParameters.emailglobalparameter",
									"type": "Expression"
								},
								"status": "success"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"Table_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-05T16:51:20Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/email pipeline')]",
				"[concat(variables('factoryId'), '/datasets/DS_sourceserver_02')]",
				"[concat(variables('factoryId'), '/datasets/DS_target_02')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_sourceserver_02')]"
			]
		},
